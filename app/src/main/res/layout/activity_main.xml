<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="WhatsApp Audio Capture — Proof of Concept"
        android:textSize="18sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <TextView
        android:id="@+id/tvExplain"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Ye sirf test karega ke phone ke internal/system audio ko capture kiya ja sakta hai ya nahi. Koi translation abhi nahi ho rahi — sirf ek WAV file save hogi jisse hum check karenge audio mein kuch capture hua ya khaali."
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnStartCapture"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Start Test Capture (10 sec)" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Status: idle"
        android:textSize="14sp"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text=""
        android:textSize="13sp"
        android:textColor="#128C7E"
        android:layout_marginTop="12dp" />

</LinearLayout>
